{
    "name": "ConditionalS3Policy",
    "resource_type": "iam_policy",
    "policy_type": "attached",
    "arn": "arn:aws:iam::123456789012:policy/ConditionalS3Policy",
    "is_inline": false,
    "document": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject"
                ],
                "Resource": "arn:aws:s3:::my-bucket/*",
                "Condition": {
                    "IpAddress": {
                        "aws:SourceIp": [
                            "203.0.113.0/24"
                        ]
                    },
                    "Bool": {
                        "aws:SecureTransport": "true"
                    }
                }
            }
        ]
    }
}