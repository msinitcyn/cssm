<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cloud Misconfiguration Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 2em;
            background-color: #f9f9f9;
        }
        h1, h2 {
            color: #333;
        }
        .section {
            margin-bottom: 2em;
        }
        .item {
            background-color: #fff;
            border-left: 5px solid #ccc;
            padding: 1em;
            margin-bottom: 1em;
        }
        .high {
            border-left-color: #e74c3c;
        }
        .medium {
            border-left-color: #f39c12;
        }
        .low {
            border-left-color: #2ecc71;
        }
        .unknown {
            border-left-color: #7f8c8d;
        }
        .label {
            font-weight: bold;
        }
        code {
            background: #eee;
            padding: 0.1em 0.3em;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <h1>Cloud Misconfiguration Report</h1>

    <div class="section">
        <h2>S3 Public Buckets</h2>
        {% if s3 %}
            {% for bucket in s3 %}
                <div class="item {{ bucket.risk | default('unknown') }}">
                    <div><span class="label">Bucket:</span> <code>{{ bucket.bucket }}</code></div>
                    <div><span class="label">Group:</span> {{ bucket.group }}</div>
                    <div><span class="label">Access:</span> {{ bucket.access_vector or "None" }}</div>
                    <div><span class="label">Public:</span> {{ bucket.public or bucket.potentially_public or false }}</div>
                    <div><span class="label">Risk:</span> {{ bucket.risk or "unknown" }}</div>
                    {% if bucket.reason %}
                    <div><span class="label">Reason:</span> {{ bucket.reason }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <p>No S3 buckets found or scan failed.</p>
        {% endif %}
    </div>

    <div class="section">
        <h2>Over-permissive IAM Roles</h2>
        {% if iam %}
            {% for role in iam %}
                <div class="item high">
                    <div><span class="label">Role:</span> <code>{{ role.role }}</code></div>
                    <div><span class="label">Policy Type:</span> {{ role.policy_type }}</div>
                    <div><span class="label">Policy Name:</span> {{ role.policy_name }}</div>
                </div>
            {% endfor %}
        {% else %}
            <p>No over-permissive IAM roles found.</p>
        {% endif %}
    </div>

    <div class="section">
        <h2>Open Security Groups</h2>
        {% if sg %}
            {% for sg_item in sg %}
                <div class="item medium">
                    <div><span class="label">Group ID:</span> <code>{{ sg_item.group_id }}</code></div>
                    <div><span class="label">Group Name:</span> {{ sg_item.group_name or "-" }}</div>
                    <div><span class="label">From Port:</span> {{ sg_item.from_port }}</div>
                    <div><span class="label">CIDR:</span> {{ sg_item.cidr }}</div>
                </div>
            {% endfor %}
        {% else %}
            <p>No open security groups found.</p>
        {% endif %}
    </div>
</body>
</html>
