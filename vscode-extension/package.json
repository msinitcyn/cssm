{
  "name": "aws-cssm",
  "displayName": "AWS Cloud Security Scanner for Misconfigurations",
  "description": "Scan AWS configurations for security misconfigurations",
  "version": "0.1.0",
  "publisher": "msin",
  "repository": {
    "type": "git", 
    "url": "https://github.com/msinitcyn/cssm"
  },
  "license": "MIT",
  "icon": "icon.png",
  "categories": ["Linters", "Other", "Testing"],
  "keywords": ["aws", "security", "iam", "s3", "scanner", "misconfiguration"],
  "homepage": "https://github.com/msinitcyn/cssm/blob/master/README.md",
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aws-scanner.scanIamRole",
        "title": "AWS Scanner: Scan IAM Role"
      },
      {
        "command": "aws-scanner.scanIamPolicy",
        "title": "AWS Scanner: Scan IAM Policy"
      },
      {
        "command": "aws-scanner.scanS3",
        "title": "AWS Scanner: Scan S3 Configuration"
      },
      {
        "command": "aws-scanner.scanSecurityGroup",
        "title": "AWS Scanner: Scan Security Group"
      }
    ],
    "configuration": {
      "title": "AWS Scanner",
      "properties": {
        "aws-scanner.cliPath": {
          "type": "string",
          "default": "aws-scanner",
          "description": "Path to aws-scanner CLI executable"
        },
        "aws-scanner.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save file before scanning"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^4.9.4"
  }
}